rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ═══════════════════════════════════════════════════════════
    // SECURITY MODEL
    //
    // Every write in this app — profile creation, KYC submission,
    // ride creation/accept/complete, all fintech operations — goes
    // through the backend's Express routes, which use the Firebase
    // Admin SDK. The Admin SDK bypasses these rules entirely, so
    // these rules only govern what a signed-in CLIENT could do
    // directly with the Firestore SDK, bypassing the backend.
    //
    // Nothing legitimate in the app ever does that. So rather than
    // trying to precisely deny only the risky fields on an otherwise
    // open document (which is exactly how the previous version of
    // these rules had two real exploitable holes — see below), the
    // safe default is: clients can READ what they're entitled to,
    // and WRITE nothing except a couple of explicitly narrow,
    // genuinely low-risk cases.
    //
    // Two concrete holes this version closes:
    //  1. `rides` previously allowed any signed-in client to CREATE a
    //     ride document directly (bypassing the backend's real fare
    //     calculation), and its update rule didn't protect `driverId`
    //     — so anyone could hijack an existing ride's driverId to
    //     their own account via a direct write, then call the real
    //     /rides/:id/complete endpoint to steal that ride's payout.
    //  2. `users`/`drivers`/`owners` denylist-style update rules
    //     didn't actually cover nested fields like `savings.balance`,
    //     `wallet.pending`, or `payLater.limit` — a client could
    //     inflate their own balance directly in Firestore, then
    //     legitimately "withdraw" the fake amount through the real
    //     backend endpoint, which trusts whatever is stored.
    // ═══════════════════════════════════════════════════════════

    // ── Users (passengers) ────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write:  if false; // profile creation + all field updates: backend only
    }

    // ── Drivers ───────────────────────────────────────────────────
    match /drivers/{driverId} {
      // Read is broad (isSignedIn only) because the real-time ride
      // dispatch and driver-matching UI need to query online drivers.
      allow read:   if isSignedIn();
      allow write:  if false; // profile creation + all field updates: backend only
    }

    // ── Owners ────────────────────────────────────────────────────
    match /owners/{ownerId} {
      allow read:   if isSignedIn() && (isOwner(ownerId) || isAdmin());
      allow write:  if false;
    }

    // ── Admins ────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read:   if isAdmin();
      allow write:  if false; // admin accounts are provisioned server-side only
    }

    // ── Rides ─────────────────────────────────────────────────────
    match /rides/{rideId} {
      // Read-only for clients — needed for the driver app's real-time
      // "new ride" listener. Every state transition (request, accept,
      // complete) happens through the backend, which is what actually
      // computes fare and moves money — never trust a client-supplied
      // fare, distance, or driverId again.
      allow read:   if isSignedIn();
      allow write:  if false;
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.driverId == request.auth.uid || isAdmin());
      // The one deliberately narrow exception: a user marking their
      // own notification read is genuinely low-risk (touches no
      // money, no identity, no verification status) and this is the
      // only field it's allowed to touch.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── KYC / License / Vehicle submissions ──────────────────────
    match /kyc_submissions/{subId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false; // submission + approval/rejection: backend only
    }
    match /license_submissions/{subId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /vehicle_submissions/{subId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Admin queue ───────────────────────────────────────────────
    match /admin_queue/{docId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    // ── Drive to Own ──────────────────────────────────────────────
    match /dto_applications/{appId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /dto_repayments/{repId} {
      allow read:   if isSignedIn() &&
        (resource.data.driverId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /fuel_codes/{code} {
      allow read:   if isSignedIn();
      allow write:  if false;
    }
    match /fuel_transactions/{txId} {
      allow read:   if isSignedIn() &&
        (resource.data.driverId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Fintech — Savings ─────────────────────────────────────────
    match /savings_transactions/{txId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Fintech — Loans ───────────────────────────────────────────
    match /loans/{loanId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /loan_repayments/{repId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Fintech — Insurance ───────────────────────────────────────
    match /insurance_policies/{polId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /insurance_claims/{claimId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /insurance_payments/{payId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Fintech — Pay Later ───────────────────────────────────────
    match /pay_later/{txId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Payments ──────────────────────────────────────────────────
    match /payments/{payId} {
      allow read:   if isSignedIn() && isAdmin();
      allow write:  if false;
    }
    match /withdrawal_requests/{reqId} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── Referrals ─────────────────────────────────────────────────
    match /referrals/{refId} {
      allow read:   if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── MaaS + Delivery ───────────────────────────────────────────
    // All read via the backend today; no client-side listener needs
    // these directly yet, but scoped read access is here for when one
    // does, without opening up writes.
    match /scheduled_trips/{id} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /subscriptions/{id} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /rentals/{id} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /shared_trips/{id} {
      allow read:   if isSignedIn();
      allow write:  if false;
    }
    match /corporate_accounts/{id} {
      allow read:   if isSignedIn() &&
        (request.auth.uid in resource.data.members || isAdmin());
      allow write:  if false;
    }
    match /event_rides/{id} {
      allow read:   if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if false;
    }
    match /deliveries/{id} {
      allow read:   if isSignedIn() &&
        (resource.data.senderId == request.auth.uid || isAdmin());
      allow write:  if false;
    }

    // ── OTPs — never readable by client ──────────────────────────
    match /otps/{phone} {
      allow read, write: if false; // Backend Admin SDK only
    }

    // ── Catch-all — deny everything else ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
